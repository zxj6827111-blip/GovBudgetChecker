{
  "name": "gov-budget-checker",
  "version": "1.0.0",
  "description": "Government Budget Checker Project",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:frontend": "npm --prefix app run dev",
    "dev:backend": "node scripts/dev-backend.cjs",
    "dev:backend:noauth": "node scripts/dev-backend.cjs --noauth",
    "setup:python": "python scripts/setup_python_env.py",
    "install:all": "npm install && npm --prefix app install && npm run setup:python"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "19.2.15",
    "concurrently": "^10.0.0",
    "typescript": "6.0.3"
  }
}
