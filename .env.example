# ========================================
# GovBudgetChecker Environment Configuration
# ========================================
# Copy this file to .env and update values as needed

# ----------------------------------------
# PostgreSQL Database Configuration
# ----------------------------------------
POSTGRES_USER=govbudget_local
POSTGRES_PASSWORD=change_me_local_postgres_password
POSTGRES_DB=fiscal_db
# For a local backend process use localhost. docker-compose.ai.yml overrides the
# host to the internal postgres service and keeps the same credentials.
DATABASE_URL=postgresql://govbudget_local:change_me_local_postgres_password@localhost:5432/fiscal_db
PG_SCHEMA=public

# ----------------------------------------
# AI Provider Configuration
# ----------------------------------------
# Recommended: use stable logical slots so future provider/model changes only
# need .env updates. Supported slot names are:
# - main: primary full-report audit
# - backup: fallback if main fails
# - locator: page/location enhancement
#
# Common provider types:
# - openai_compat: Gemini gateway / Codex gateway / Kimi / most OpenAI-compatible APIs
# - zhipu: Zhipu native provider
# - doubao: Ark / Doubao native provider

AI_MAIN_PROVIDER=main
AI_MAIN_MODEL=gpt-5.4
AI_MAIN_PROVIDER_TYPE=openai_compat
AI_MAIN_BASE_URL=https://your-openai-compatible-main-endpoint/v1
AI_MAIN_API_KEY=your_main_api_key

# Optional override. If left empty, audit inherits AI_MAIN_PROVIDER + AI_MAIN_MODEL.
AI_AUDIT_PROVIDER=
AI_AUDIT_MODEL=

AI_BACKUP_PROVIDER_TYPE=openai_compat
AI_BACKUP_BASE_URL=https://your-openai-compatible-backup-endpoint/v1
AI_BACKUP_API_KEY=your_backup_api_key
AI_BACKUP_MODEL=gemini-2.5-pro

AI_LOCATOR_PROVIDER=locator
AI_LOCATOR_MODEL=gemini-2.5-flash
AI_LOCATOR_PROVIDER_TYPE=openai_compat
AI_LOCATOR_BASE_URL=https://your-openai-compatible-locator-endpoint/v1
AI_LOCATOR_API_KEY=your_locator_api_key

AI_FALLBACK_CHAIN=main,backup,locator

# 每个 slot 还支持下面三个可选项（src/services/ai_client.py:_build_env_provider_slot）
# AI_MAIN_ENABLED=true
# AI_MAIN_TIMEOUT_S=90
# AI_MAIN_RETRIES=1
# AI_BACKUP_ENABLED=true
# AI_BACKUP_TIMEOUT_S=90
# AI_BACKUP_RETRIES=1
# AI_LOCATOR_ENABLED=true
# AI_LOCATOR_TIMEOUT_S=90
# AI_LOCATOR_RETRIES=1

# 按 provider 名取 key 的方式（config/providers.yaml 的 api_key_env 指向这些变量）。
# 注意：只有 *_API_KEY 会被读取；providers.yaml 里的 base/model 是写死的，
# 因此历史上的 GEMINI_BASE_URL / GEMINI_MAIN_MODEL / GEMINI_LOCATOR_MODEL /
# CODEX_BASE_URL / CODEX_MODEL 代码从不读取，已从本文件与 compose 移除
# （详见 docs/ENV_VARS_RECONCILIATION.md）。
GEMINI_API_KEY=
CODEX_API_KEY=
ARK_API_KEY=
OPENAI_API_KEY=
ZHIPU_API_KEY=

# ----------------------------------------
# System Configuration
# ----------------------------------------
AI_ASSIST_ENABLED=true
AI_EXTRACTOR_URL=http://127.0.0.1:9009/ai/extract/v1
AI_EXTRACTOR_DIRECT_FALLBACK=true
# AI_EXTRACTOR_TIMEOUT=120
# AI_EXTRACTOR_MAX_RETRIES=2
# AI_EXTRACTOR_RETRY_DELAY=2
# AI_MAIN_MODEL 的历史别名，仅在未配置 AI_MAIN_MODEL 时生效
# AI_EXTRACTOR_MODEL=
# AI 语义审计的滑窗参数（src/services/ai_findings.py）
# AI_AUDIT_WINDOW_CHARS=12000
# AI_AUDIT_WINDOW_OVERLAP=1200
# AI_AUDIT_MAX_WINDOWS=12
# AI_AUDIT_MAX_CONCURRENCY=2
# AI 问题的最低置信度，低于该值直接丢弃
# AI_MIN_ISSUE_CONFIDENCE=0.75

# Runtime storage
HOST_DATA_DIR=/opt/GovBudgetChecker-data/data
HOST_LOGS_DIR=/opt/GovBudgetChecker-data/logs
HOST_SAMPLES_DIR=/opt/GovBudgetChecker-data/samples
HOST_UPLOADS_DIR=/opt/GovBudgetChecker-data/uploads
# 当前内置存储实现为挂载的持久化文件卷；数据库仅保存 storage_key 和元数据。
DOCUMENT_STORAGE_BACKEND=filesystem

# ----------------------------------------
# API Security
# ----------------------------------------
GOVBUDGET_AUTH_ENABLED=true
GOVBUDGET_API_KEY=change_me_to_a_strong_secret
GOVBUDGET_RATE_LIMIT=100
USER_SESSION_SECRET=change_me_to_a_different_strong_secret
DEFAULT_ADMIN_PASSWORD=change_me_to_a_unique_admin_password
# docker-compose.ai.yml overrides this to /app/logs/admin-actions.jsonl.
AUDIT_LOG_PATH=/opt/GovBudgetChecker-data/logs/admin-actions.jsonl
# 活动流接口（GET /api/activity，Task 3）单次最多从审计日志文件末尾扫描多少行；
# 不配置时默认 20000，防止日志文件异常膨胀后一次性读爆内存。
# AUDIT_LOG_MAX_SCAN_LINES=20000

MAX_UPLOAD_MB=30
MAX_UPLOAD_PAGES=800

# ----------------------------------------
# Queue / Batch flow
# ----------------------------------------
AI_SEQUENTIAL_MODE=true
# JOB_QUEUE_WORKERS=12
JOB_QUEUE_ROLE=all
JOB_QUEUE_INLINE_FALLBACK=false
# 说明：docker compose 里 backend 固定 JOB_QUEUE_ROLE=api、worker 固定 =worker，
# 上面这个值只影响裸机 / make backend 这类单进程启动方式。
# JOB_QUEUE_ENABLED=true
# JOB_QUEUE_RESUME_ON_START=true
# JOB_QUEUE_POLL_INTERVAL_SECONDS=2
# JOB_QUEUE_CLAIM_TTL_SECONDS=900
# JOB_QUEUE_HEARTBEAT_MAX_AGE_SECONDS=15

# ----------------------------------------
# Compose 一键起全组件（可选）
# ----------------------------------------
# 写上这一行后，直接 `docker compose up -d --build` 就会同时起
# postgres + ai-extractor + backend + worker + frontend。
# 分隔符跟平台有关：Linux/macOS 用 ":"，Windows 用 ";"。
# COMPOSE_FILE=docker-compose.yml:docker-compose.ai.yml

# ----------------------------------------
# 任务产物与上传（生产必须挂持久化卷）
# ----------------------------------------
# 代码默认值是相对路径 uploads；容器里由 docker-compose.ai.yml 覆盖成 /app/uploads。
UPLOAD_DIR=uploads
# UPLOAD_CHUNK_BYTES=1048576
# MAX_ORG_IMPORT_MB=20
# 规则集文件（api/config.py / /ready 的 rules_file_exists 检查都读这个）
# RULES_FILE=rules/v3_3.yaml

# ----------------------------------------
# 日志与指标（Task 10/11 · 缺口 B-05 / B-06）
# ----------------------------------------
# LOG_LEVEL=INFO
# 不配置时按 stdout 是否 TTY 自动判断：容器默认 JSON，本地终端默认可读格式
# LOG_JSON=true
# LOG_FILE=
# METRICS_ENABLED=true
# METRICS_API_TOKEN=
# METRICS_CACHE_TTL_SECONDS=15
# METRICS_MAX_JOBS=2000

# ----------------------------------------
# 质量门禁阈值（Task 2/3 · 缺口 B-01 / B-03）
# ----------------------------------------
# 单页可见字符数低于该值即判为疑似扫描页/低文本页
# SCANNED_PAGE_MIN_CHARS=50
# 页面覆盖率低于该比例即整单转 review_required
# PAGE_COVERAGE_MIN_RATIO=0.8
# AI 辅助被视为"必需"时，AI 失败会让任务转 review_required 而不是 done
# AI_ASSIST_REQUIRED=false

# ----------------------------------------
# 解析与规则超时 / 资源隔离（Task 13 · 缺口 B-09 / P2-05）
# ----------------------------------------
# PIPELINE_TIMEOUT_SEC=600
# RULES_TIMEOUT_SEC=150
# PDF_PARSE_ISOLATION_ENABLED=true
# PDF_PARSE_TIMEOUT_SEC=120
# PDF_PARSE_MAX_PAGES 缺省跟随 MAX_UPLOAD_PAGES
# PDF_PARSE_MAX_PAGES=800
# PDF_PARSE_MAX_TEXT_CHARS=20000000
# PDF_PARSE_MAX_TABLE_CELLS=2000000
# 仅 POSIX 生效（Windows 无 RLIMIT_AS）
# PDF_PARSE_MEMORY_MB=1024

# ----------------------------------------
# 安全响应头与首登改密（Task 12 · 缺口 B-07 / B-08）
# ----------------------------------------
# SECURITY_HEADERS_ENABLED=true
# 默认只在 HTTPS 或 X-Forwarded-Proto: https 时下发 HSTS
# SECURITY_HSTS_ALWAYS=false
# HSTS 取值覆盖（留空用内置默认）
# SECURITY_HSTS=
# SECURITY_CSP=
# SECURITY_CSP_DOCS=
# SECURITY_FRAME_OPTIONS=DENY
# SECURITY_REFERRER_POLICY=no-referrer
# REQUIRE_FIRST_LOGIN_PASSWORD_CHANGE=true

# ----------------------------------------
# 账号 / 会话 / 登录保护
# ----------------------------------------
# DEFAULT_ADMIN_USERNAME=admin
# USER_SESSION_TTL_SECONDS=28800
# USER_PASSWORD_MIN_LENGTH=6
# USER_PASSWORD_ITERATIONS=260000
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_DURATION=900
# 额外的管理员级 API Key（逗号分隔）
# GOVBUDGET_ADMIN_API_KEYS=
# 额外允许的前端来源（逗号分隔，追加在内置白名单之后）
# ALLOW_ORIGINS=

# ----------------------------------------
# 就绪检查与运维
# ----------------------------------------
# READY_REQUIRE_DATABASE=true
# READY_REQUIRE_AI_EXTRACTOR=true
# /ready?details=true 是否返回明细（默认关闭，避免暴露内部路径）
# READY_EXPOSE_DETAILS=false
# scripts/backup_all.py 找 pg_dump/psql 的目录（PATH 里没有时用）
# PG_BIN_DIR=

# ----------------------------------------
# 本地状态文件目录（默认都在 data/ 下）
# ----------------------------------------
# 组织/部门数据目录
# ORG_DATA_DIR=data
# 用户库目录与文件名
# USER_DATA_DIR=data
# USER_FILE=users.json
# 历史遗留账号的初始口令（仅迁移旧账号时用到，生产应尽快改掉）
# DEFAULT_LEGACY_PASSWORD=change_me_123

# ----------------------------------------
# 查询缓存与数据库超时
# ----------------------------------------
# DEPARTMENT_STATS_CACHE_TTL_SECONDS=3
# DEPARTMENT_STATS_CACHE_MAX_SIZE=512
# 问题工作流镜像写库的超时（秒），超时只影响镜像不阻塞主流程
# WORKFLOW_DB_TIMEOUT_SECONDS=3
